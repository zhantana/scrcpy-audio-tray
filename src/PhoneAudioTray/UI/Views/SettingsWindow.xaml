<Window x:Class="PhoneAudioTray.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="560" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1C1C22">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" x:Name="RootPanel">
            <TextBlock Text="画质与性能" Foreground="#5CD6A0" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

            <!-- 码率 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="视频码率" Foreground="#DDD" FontSize="13"/>
                    <TextBlock Text="越高越清晰，编码和传输压力越大" Foreground="#888" FontSize="11"/>
                </StackPanel>
                <ComboBox x:Name="CmbBitrate" Width="150" VerticalAlignment="Center" SelectionChanged="CmbBitrate_SelectionChanged">
                    <ComboBoxItem Content="4 Mbps" Tag="4000000"/>
                    <ComboBoxItem Content="8 Mbps（scrcpy 默认）" Tag="8000000"/>
                    <ComboBoxItem Content="16 Mbps（推荐）" Tag="16000000" IsSelected="True"/>
                    <ComboBoxItem Content="32 Mbps" Tag="32000000"/>
                </ComboBox>
            </Grid>

            <!-- 编码格式 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="视频编码" Foreground="#DDD" FontSize="13"/>
                    <TextBlock Text="H.265/AV1 同码率画质更好，取决于手机支持" Foreground="#888" FontSize="11"/>
                </StackPanel>
                <ComboBox x:Name="CmbCodec" Width="150" VerticalAlignment="Center">
                    <ComboBoxItem Content="H.264" Tag="h264"/>
                    <ComboBoxItem Content="H.265" Tag="h265"/>
                    <ComboBoxItem Content="AV1" Tag="av1"/>
                </ComboBox>
            </Grid>

            <!-- 帧率 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="帧率上限" Foreground="#DDD" FontSize="13"/>
                    <TextBlock Text="手机原生 90，卡顿可降到 30" Foreground="#888" FontSize="11"/>
                </StackPanel>
                <ComboBox x:Name="CmbFps" Width="150" VerticalAlignment="Center">
                    <ComboBoxItem Content="30 fps" Tag="30"/>
                    <ComboBoxItem Content="60 fps（默认）" Tag="60"/>
                    <ComboBoxItem Content="90 fps（原生）" Tag="90"/>
                    <ComboBoxItem Content="不限" Tag="0"/>
                </ComboBox>
            </Grid>

            <!-- 分辨率 -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="分辨率" Foreground="#DDD" FontSize="13"/>
                    <TextBlock Text="降分辨率能明显减压，清晰度略降" Foreground="#888" FontSize="11"/>
                </StackPanel>
                <ComboBox x:Name="CmbSize" Width="150" VerticalAlignment="Center">
                    <ComboBoxItem Content="原始（推荐）" Tag="0"/>
                    <ComboBoxItem Content="1080p" Tag="1080"/>
                    <ComboBoxItem Content="720p" Tag="720"/>
                </ComboBox>
            </Grid>

            <TextBlock Text="音频与延迟" Foreground="#5CD6A0" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="音频缓冲" Foreground="#DDD" FontSize="13"/>
                    <TextBlock Text="越大越抗抖动，延迟略增" Foreground="#888" FontSize="11"/>
                </StackPanel>
                <ComboBox x:Name="CmbBuffer" Width="150" VerticalAlignment="Center">
                    <ComboBoxItem Content="20 ms" Tag="20"/>
                    <ComboBoxItem Content="40 ms（默认）" Tag="40"/>
                    <ComboBoxItem Content="80 ms" Tag="80"/>
                </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="音频编码" Foreground="#DDD" FontSize="13" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbAudioCodec" Width="150" VerticalAlignment="Center">
                    <ComboBoxItem Content="无损 raw（推荐）" Tag="raw"/>
                    <ComboBoxItem Content="Opus" Tag="opus"/>
                </ComboBox>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="80" Height="34" Margin="0,0,12,0"
                        Background="#2A2A32" Foreground="#CCC" BorderThickness="0" Click="Cancel_Click"/>
                <Button Content="保存并应用" Width="120" Height="34"
                        Background="#3A7afe" Foreground="White" BorderThickness="0" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
