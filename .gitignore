# 本机敏感配置：锁屏密码、WiFi 地址、设备序列号、别名
device-pin.json
settings.json
wifi_target.txt
device-names.json

# 本机私有环境变量（模板 .env.example 入库）
.env
.env.*
!.env.example

# 构建产物（安装包 219MB）
dist/

# 工作区数据
.workbuddy/

# 所有 .local 目录：本机私有文档与笔记，一律不入库
*.local/

# 运行时日志
*.log

# scrcpy 与 adb 二进制（体积大，由构建脚本从 winget 目录拷贝）
scrcpy/

# 编译产物
bin/
obj/
dist-v2/
*.user
build/tmp/
